From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mhavant <matthew.hoelting@avant.com>
Date: Thu, 22 Oct 2026 01:10:46 -0500
Subject: [PATCH] fix(claude-native): count agent-team teammates as background
 agents

Claude Code lists an in-process teammate in a Stop hook's background_tasks
with type "teammate". It was counted as a background shell, so the shell
indicator over-counted, and a lead whose teammates were still running
never got the delegate holdover, so it stayed Working after its turn.

Not upstream yet: proposed alongside upstream PR #10849.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mhavant <matthew.hoelting@avant.com>
---
 omnigent/harnesses/claude_native/bridge.py    |  5 +++-
 .../test_claude_native_bridge.py              | 26 +++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/omnigent/harnesses/claude_native/bridge.py b/omnigent/harnesses/claude_native/bridge.py
index d0f13dae92a372a03a30cd03172ded31c03cf01a..161fab63ae154bd07bac3e5425be43d769b12b98 100644
--- a/omnigent/harnesses/claude_native/bridge.py
+++ b/omnigent/harnesses/claude_native/bridge.py
@@ -3911,7 +3911,10 @@ _TERMINAL_BACKGROUND_TASK_STATUSES: frozenset[str] = frozenset(
 _BACKGROUND_TASK_FORWARD_LIMIT = 100
 _BACKGROUND_TASK_FIELD_MAX_CHARS = 512
 _BACKGROUND_TASK_FIELDS: tuple[str, ...] = ("id", "type", "status", "description", "command")
-_BACKGROUND_AGENT_TASK_TYPES: frozenset[str] = frozenset({"agent", "local_agent", "subagent"})
+# ``teammate`` is an in-process agent-team teammate; it keeps the lead busy too.
+_BACKGROUND_AGENT_TASK_TYPES: frozenset[str] = frozenset(
+    {"agent", "local_agent", "subagent", "teammate"}
+)
 
 
 def _is_background_shell(raw: object) -> bool:
diff --git a/tests/harnesses/claude_native/test_claude_native_bridge.py b/tests/harnesses/claude_native/test_claude_native_bridge.py
index 7d1f4731cb09c5d2de1a676e95200b0e12abc54d..6dd27f9c35ffce07e722bd90695b5653a540f288 100644
--- a/tests/harnesses/claude_native/test_claude_native_bridge.py
+++ b/tests/harnesses/claude_native/test_claude_native_bridge.py
@@ -10641,6 +10641,32 @@ def test_hook_record_stop_excludes_backgrounded_subagents() -> None:
     ]
 
 
+def test_hook_record_stop_counts_running_teammates_as_background_agents() -> None:
+    """Agent-team teammates keep the lead busy like a background sub-agent.
+
+    They must mark a background agent running and stay out of the shell tally.
+    """
+    record = _hook_record_from_jsonl_record(
+        _make_jsonl_record(
+            {
+                "hook_event_name": "Stop",
+                "background_tasks": [
+                    {
+                        "id": "teammate-task",
+                        "type": "teammate",
+                        "status": "running",
+                        "description": "Investigate the failing check",
+                    },
+                ],
+            }
+        )
+    )
+
+    assert record.background_task_count == 0
+    assert record.background_agent_running is True
+    assert record.background_tasks is None
+
+
